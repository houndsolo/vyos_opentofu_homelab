provider_installation {
  filesystem_mirror {
    path = "/home/mechanic/.local/share/tofu/provider-mirror"

    include = [
      "registry.terraform.io/houndsolo/vyoscmd",
      "local/mechanic/proxmox",
    ]
  }

  direct {
    exclude = [
      "registry.terraform.io/houndsolo/vyoscmd",
      "local/mechanic/proxmox",
    ]
  }
}
